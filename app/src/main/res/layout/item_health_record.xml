<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="14dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:id="@+id/recordIconBg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle">

        <ImageView
            android:id="@+id/recordIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_meds" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Vaccination" />

        <TextView
            android:id="@+id/recordMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            tools:text="12 Mar 2026 · Rabies booster, City Vet Clinic" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/recordDelete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete record"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_trash"
        app:tint="@color/app_text_secondary" />
</LinearLayout>
