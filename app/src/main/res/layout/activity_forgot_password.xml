<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_bg"
    tools:context=".ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Header Logo & Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_petcare_logo_circle"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="PetCare"
                android:textColor="@color/auth_text_navy"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Smart Pet Health &amp; Care Companion"
                android:textColor="@color/auth_text_grey"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Reset Password"
            android:textColor="@color/auth_text_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Enter your email to set a new secure password"
            android:textColor="@color/auth_text_grey"
            android:textSize="14sp" />

        <!-- Email Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Email address"
            android:textColor="@color/auth_text_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_auth_pill_input">

            <ImageView
                android:id="@+id/iconRecoveryEmail"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_email"
                app:tint="@color/auth_text_grey"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/recoveryEmailInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/iconRecoveryEmail"
                android:background="@android:color/transparent"
                android:hint="alex@example.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textColor="@color/auth_text_navy"
                android:textColorHint="@color/md_outline"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- New Password Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="New Password"
            android:textColor="@color/auth_text_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_auth_pill_input">

            <ImageView
                android:id="@+id/iconRecoveryPassword"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/auth_text_grey"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/recoveryPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/recoveryPasswordEye"
                android:layout_toEndOf="@id/iconRecoveryPassword"
                android:background="@android:color/transparent"
                android:hint="New password"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="@color/auth_text_navy"
                android:textColorHint="@color/md_outline"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/recoveryPasswordEye"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/auth_text_grey"
                tools:ignore="ContentDescription" />
        </RelativeLayout>

        <!-- Confirm Password Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Confirm New Password"
            android:textColor="@color/auth_text_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_auth_pill_input">

            <ImageView
                android:id="@+id/iconRecoveryConfirmPassword"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/auth_text_grey"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/recoveryConfirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/recoveryConfirmPasswordEye"
                android:layout_toEndOf="@id/iconRecoveryConfirmPassword"
                android:background="@android:color/transparent"
                android:hint="Repeat new password"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="@color/auth_text_navy"
                android:textColorHint="@color/md_outline"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/recoveryConfirmPasswordEye"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/auth_text_grey"
                tools:ignore="ContentDescription" />
        </RelativeLayout>

        <!-- Update Password Button -->
        <Button
            android:id="@+id/recoverySaveButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill_button_teal"
            android:text="Update Password →"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/backToLoginLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="← Back to Sign in"
            android:textColor="@color/auth_text_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
