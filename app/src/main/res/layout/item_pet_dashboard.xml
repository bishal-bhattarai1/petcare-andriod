<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="64dp"
                android:layout_height="64dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imagePetAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/app_input_bg"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_paw"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                    app:strokeColor="@color/app_divider"
                    app:strokeWidth="1dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/avatarContainer"
                android:layout_toStartOf="@+id/textTaskRatio"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textPetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/app_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Buddy" />

                <TextView
                    android:id="@+id/textFestiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Adoption Anniversary!"
                    android:textColor="@color/status_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textPetBreed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp"
                    tools:text="Golden Retriever" />

                <TextView
                    android:id="@+id/textStatusAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/app_accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Vaccination due tomorrow"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/textTaskRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_pill_button_black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="4 / 6" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/petProgressBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progress="60"
                app:indicatorColor="@color/status_green"
                app:trackColor="@color/indicator_grey"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Care Progress"
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/app_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipFed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_button_grey"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Fed"
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_bowl"
                app:drawableTint="@color/indicator_grey" />

            <TextView
                android:id="@+id/chipWalked"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_button_grey"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Walked"
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_walk"
                app:drawableTint="@color/indicator_grey" />

            <TextView
                android:id="@+id/chipMeds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_button_grey"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Meds"
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_meds"
                app:drawableTint="@color/indicator_grey" />

            <TextView
                android:id="@+id/chipGroom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button_grey"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Groom"
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_groom"
                app:drawableTint="@color/indicator_grey" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
