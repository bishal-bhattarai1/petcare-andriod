<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imagePetAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/app_input_bg"
                    android:padding="12dp"
                    android:src="@drawable/ic_paw"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/app_divider"
                    app:strokeWidth="1dp" />

                <ImageView
                    android:id="@+id/imageStatusBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_status_check" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/avatarContainer"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textPetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buddy"
                    android:textColor="@color/app_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPetBreed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Golden Retriever"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textStatusAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vaccination due tomorrow"
                    android:textColor="@color/app_accent_red"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/petProgressBar"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progress="60"
                    app:indicatorColor="@color/status_green"
                    app:trackColor="@color/indicator_grey"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textTaskRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="4/6"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/app_divider" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Dynamic Chips Styled via Adapter -->
                <TextView
                    android:id="@+id/chipFed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="Fed"
                    android:textColor="@color/status_green"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_bowl"
                    app:drawableTint="@color/status_green" />

                <TextView
                    android:id="@+id/chipWalked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="Walked"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_walk"
                    app:drawableTint="@color/indicator_grey" />

                <TextView
                    android:id="@+id/chipMeds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="Meds"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_meds"
                    app:drawableTint="@color/indicator_grey" />

                <TextView
                    android:id="@+id/chipGroom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="Groom"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_groom"
                    app:drawableTint="@color/indicator_grey" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>