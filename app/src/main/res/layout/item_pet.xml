<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Circular Avatar Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/petIconCard"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="30dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:id="@+id/textViewPetIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🐾"
                android:textSize="24sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Information Block -->
        <TextView
            android:id="@+id/textViewPetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Pet Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toEndOf="@id/petIconCard"
            app:layout_constraintTop_toTopOf="@id/petIconCard"
            app:layout_constraintEnd_toStartOf="@id/buttonEditPet" />

        <TextView
            android:id="@+id/textViewPetBreed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Breed Details"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@id/textViewPetName"
            app:layout_constraintTop_toBottomOf="@id/textViewPetName"
            app:layout_constraintEnd_toEndOf="@id/textViewPetName" />

        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@id/textViewPetName"
            app:layout_constraintTop_toBottomOf="@id/textViewPetBreed"
            app:layout_constraintEnd_toEndOf="@id/textViewPetName">

            <TextView
                android:id="@+id/textViewPetAgeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="2 Yrs"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/textViewPetWeightChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="15 kg"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>

        <!-- Modern Edit Action -->
        <ImageButton
            android:id="@+id/buttonEditPet"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="Edit Pet" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>