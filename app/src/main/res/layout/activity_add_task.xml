<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bg"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="New Care Routine"
            app:titleCentered="true" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan a care activity"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary" />

            <!-- Task Description -->
            <EditText
                android:id="@+id/editTextDesc"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_pill_input"
                android:hint="What needs to be done?"
                android:inputType="textCapSentences"
                android:paddingHorizontal="24dp" />

            <!-- Expense Tracking -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp"
                android:text="Estimated Expense"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary" />

            <EditText
                android:id="@+id/editTextExpense"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_input"
                android:hint="$0.00"
                android:inputType="numberDecimal"
                android:paddingHorizontal="24dp" />

            <!-- Delegation Placeholder -->
            <CheckBox
                android:id="@+id/checkDelegate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Delegate this task to others"
                android:textColor="@color/app_text_primary"
                android:buttonTint="@color/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSaveTask"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:text="Save Routine"
                android:textStyle="bold"
                android:textSize="18sp"
                app:cornerRadius="32dp"
                android:backgroundTint="@color/black"
                android:textColor="@color/white" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>