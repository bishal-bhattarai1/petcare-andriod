<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PetCare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/petcare_primary</item>
        <item name="colorOnPrimary">@color/petcare_on_primary</item>
        <item name="colorPrimaryContainer">@color/petcare_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/petcare_on_primary_container</item>
        <item name="colorSecondary">@color/petcare_secondary</item>
        <item name="colorOnSecondary">@color/petcare_on_secondary</item>
        <item name="colorSecondaryContainer">@color/petcare_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/petcare_on_secondary_container</item>
        <item name="colorTertiary">@color/petcare_tertiary</item>
        <item name="colorError">@color/petcare_error</item>
        <item name="colorSurface">@color/petcare_surface</item>
        <item name="colorSurfaceContainerLow">@color/petcare_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/petcare_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/petcare_surface_container_high</item>
        <item name="colorOnSurface">@color/petcare_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/petcare_on_surface_variant</item>
        <item name="colorOutline">@color/petcare_outline</item>
        <item name="colorOutlineVariant">@color/petcare_outline_variant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/petcare_surface</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.PetCare" parent="Base.Theme.PetCare" />

    <style name="PetCare.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PetCare.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PetCare.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/petcare_outline</item>
        <item name="hintTextColor">@color/petcare_on_surface_variant</item>
        <item name="startIconTint">@color/petcare_on_surface_variant</item>
        <item name="endIconTint">@color/petcare_on_surface_variant</item>
    </style>

    <style name="PetCare.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/petcare_outline_variant</item>
        <item name="cardBackgroundColor">@color/petcare_surface</item>
    </style>
</resources>
