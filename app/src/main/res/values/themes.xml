<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Material 3, primary navy #18414D, accent #F8AA4A, cream #FFF2E5, Figtree. -->
    <style name="Base.Theme.PetCare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_surface</item>
        <item name="colorSurface">@color/md_background</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_background</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Shapes: cards 20dp, buttons 28dp (pill) -->
        <item name="materialCardViewStyle">@style/Widget.PetCare.Card</item>
        <item name="materialButtonStyle">@style/Widget.PetCare.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.PetCare.Fab</item>
        <item name="snackbarStyle">@style/Widget.PetCare.Snackbar</item>

        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>

        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:statusBarColor">@color/md_background</item>
        <item name="android:navigationBarColor">@color/md_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PetCare" parent="Base.Theme.PetCare" />

    <style name="Widget.PetCare.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/md_surface_container_low</item>
    </style>

    <style name="Widget.PetCare.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.PetCare.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/md_secondary</item>
        <item name="tint">@color/md_on_secondary</item>
    </style>

    <style name="Widget.PetCare.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/snackbar_bg</item>
    </style>

    <!-- Filled-look outlined text field used by forms (Add pet, etc.) -->
    <style name="Widget.PetCare.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/app_input_bg</item>
        <item name="boxStrokeColor">@color/md_primary</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/md_primary</item>
    </style>

    <!-- Selectable species chip -->
    <style name="Widget.PetCare.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_selectable_bg</item>
        <item name="chipStrokeColor">@color/chip_selectable_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_selectable_text</item>
        <item name="chipIconTint">@color/chip_selectable_text</item>
        <item name="chipIconSize">18dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
    </style>
</resources>
